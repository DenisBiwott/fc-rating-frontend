# See docs/CONFIGURATION.md for why each of these exists.

# true runs entirely against MSW with the deterministic seed — no backend needed.
VITE_USE_MOCKS=true

# Base URL of the running API, e.g. http://localhost:3000. Required when VITE_USE_MOCKS=false.
# The real backend has no /api/v1 prefix (see CLAUDE.md) — do not append one here.
VITE_API_BASE=http://localhost:3000

# Path or URL to the backend's openapi.json, used only by `pnpm sync-contract` (build-time, not
# read at runtime).
CONTRACT_SOURCE=../fc-rating-backend/openapi.json
